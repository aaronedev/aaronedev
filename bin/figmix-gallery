#!/usr/bin/env bash
# Capture static artifacts from the canonical dotfile banner functions.
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPOSITORY_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly DEFAULT_OUTPUT_DIR="${REPOSITORY_ROOT}/assets/generated"
readonly DEFAULT_SOURCE_PATH="${XDG_CONFIG_HOME:-${HOME}/.config}/bash/source/toiletbox_figletbox.sh"

text=""
output_dir="${DEFAULT_OUTPUT_DIR}"
output_dir_explicit=0
format="both"
mode=""
capture_kind=""
output_name=""
source_path="${FIGMIX_BASH_SOURCE:-${DEFAULT_SOURCE_PATH}}"
forward_args=()
temporary_files=()
combine_layouts=0
max_variants=""

readonly -a LAYOUT_ALIGNS=(top middle bottom)
readonly -a LAYOUT_SPACES=(0 1 3 6)

usage() {
  cat <<'EOF'
Usage: figmix-gallery MODE --text TEXT [options]

Capture static output from the real figmix, toiletbox, and figletbox functions in the canonical
Bash module. Style arguments following -- are forwarded unchanged to the selected function.

Modes:
  --profile                    Render the fixed profile figmix word-split banner.
  --all                        Render every curated static feature axis.
  --all-layouts                Render each static figmix split, box, alignment, and spacing axis.
  --all-filters                Render each figmix TOIlet filter position plus an unfiltered control.
  --all-mixes                  Render every ordered curated two-sided figmix font pairing.
  --capture KIND               Capture one real function: figmix, toiletbox, or figletbox.

Options:
  --text TEXT                  Positional banner text. Optional for figmix capture with --head
                               or --tail; otherwise required.
  --output-name NAME           Required base name for --capture artifacts.
  --output-dir DIR             Generated artifact directory. Profile/capture default to the
                               repository's assets/generated path.
  --format FORMAT              text, png, or both (default: both).
  --combine-layouts            With --all-mixes, render every finite split/box/align/spacing
                               combination for each ordered font mix. Requires --max-variants.
  --max-variants N             Required cap for --all-mixes --combine-layouts.
  --                           Forward all remaining real style arguments verbatim.
  --help                       Show this help.

Live timer arguments (--timer, --heading, alarms, and related options) are refused in --capture:
they do not terminate into a stable static artifact.

Broad gallery modes require an explicit --output-dir. This avoids unexpected output when the
command is run from a subdirectory.

--combine-layouts calculates the exact planned count from the source-owned curated arrays before
sourcing or rendering and refuses work above --max-variants.

Environment:
  FIGMIX_BASH_SOURCE           Explicit toiletbox_figletbox.sh source path.
  XDG_CONFIG_HOME              Used to resolve the default Bash source path.

PNG output uses ansilove to preserve the captured terminal artifact, including ANSI output.
EOF
}

die() {
  printf 'figmix-gallery: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  local path
  for path in "${temporary_files[@]:-}"; do
    [[ -n "${path}" ]] && rm -f -- "${path}"
  done
  return 0
}
trap cleanup EXIT

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_module_contract() {
  local function_name
  local array_name

  for function_name in figmix toiletbox figletbox __banner_default_font; do
    declare -F "${function_name}" >/dev/null || \
      die "canonical source module does not define function: ${function_name}"
  done

  for array_name in __banner_toilet_fonts __banner_figlet_fonts __banner_boxes \
    __banner_toilet_filters; do
    declare -p "${array_name}" 2>/dev/null | grep -q '^declare -a' || \
      die "canonical source module does not define array: ${array_name}"
  done
}

shell_command() {
  local argument
  local rendered=""

  for argument in "$@"; do
    printf -v argument '%q' "${argument}"
    rendered+="${rendered:+ }${argument}"
  done
  printf '%s' "${rendered}"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cs 'a-z0-9._-' '-' | \
    sed -E 's/^-+//; s/-+$//'
}

has_multiple_words() {
  [[ "${text}" =~ [^[:space:]][[:space:]]+[^[:space:]] ]]
}

character_split_count() {
  local length=${#text}
  if ((length > 1)); then
    printf '%s\n' "$((length - 1))"
  else
    printf '0\n'
  fi
}

# Count literal source-owned array entries without executing the module. This is deliberately
# limited to the static declaration format used by the canonical module, and is only used for the
# --combine-layouts safety preflight. The real module is still sourced before any actual capture.
literal_array_count() {
  local array_name="$1"
  local line=""
  local remainder=""
  local content=""
  local collecting=0
  local character=""
  local quote=""
  local token_started=0
  local count=0
  local index=0

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if ((collecting == 0)); then
      line="${line#"${line%%[![:space:]]*}"}"
      [[ "${line}" == "${array_name}"* ]] || continue
      remainder="${line#"${array_name}"}"
      remainder="${remainder#"${remainder%%[![:space:]]*}"}"
      [[ "${remainder}" == =\(* ]] || continue
      remainder="${remainder#=\(}"
      collecting=1
    else
      remainder="${line}"
    fi

    if [[ "${remainder}" == *')'* ]]; then
      content+="${remainder%%)*}"
      break
    fi
    content+="${remainder}"$'\n'
  done < "${source_path}"

  ((collecting == 1)) || die "canonical source module does not declare array: ${array_name}"

  for ((index = 0; index < ${#content}; index++)); do
    character="${content:index:1}"
    if [[ -n "${quote}" ]]; then
      if [[ "${character}" == "${quote}" ]]; then
        quote=""
      fi
      token_started=1
      continue
    fi

    case "${character}" in
      "'"|'"')
        quote="${character}"
        token_started=1
        ;;
      ' '|$'\t'|$'\n'|$'\r')
        if ((token_started == 1)); then
          ((count += 1))
          token_started=0
        fi
        ;;
      *) token_started=1 ;;
    esac
  done
  ((token_started == 1)) && ((count += 1))
  printf '%s\n' "${count}"
}

combined_layout_count() {
  local figlet_count
  local toilet_count
  local box_count
  local split_count
  local font_mix_count

  figlet_count="$(literal_array_count __banner_figlet_fonts)"
  toilet_count="$(literal_array_count __banner_toilet_fonts)"
  box_count="$(literal_array_count __banner_boxes)"
  split_count="$(character_split_count)"
  has_multiple_words && ((split_count += 1))
  ((split_count > 0)) || die "--combine-layouts requires text with a non-empty split boundary"

  font_mix_count=$(( (figlet_count + toilet_count) * (figlet_count + toilet_count) ))
  printf '%s\n' "$((font_mix_count * split_count * (box_count + 1) * ${#LAYOUT_ALIGNS[@]} * ${#LAYOUT_SPACES[@]}))"
}

artifact_link() {
  local base_name="$1"
  local extension="$2"

  if [[ "${format}" == "png" && "${extension}" == "txt" ]] || \
    [[ "${format}" == "text" && "${extension}" == "png" ]]; then
    printf '—'
  else
    printf '[%s.%s](%s.%s)' "${base_name}" "${extension}" "${base_name}" "${extension}"
  fi
}

capture_variant() {
  local base_name="$1"
  shift
  local command_text
  local temporary_text
  local text_path="${output_dir}/${base_name}.txt"
  local png_path="${output_dir}/${base_name}.png"

  command_text="$(shell_command "$@")"
  temporary_text="$(mktemp "${output_dir}/.${base_name}.XXXXXX.txt")"
  temporary_files+=("${temporary_text}")
  "$@" > "${temporary_text}"

  if [[ "${format}" == "text" || "${format}" == "both" ]]; then
    cp "${temporary_text}" "${text_path}"
  fi

  if [[ "${format}" == "png" || "${format}" == "both" ]]; then
    ansilove -o "${png_path}" "${temporary_text}"
  fi

  printf '%s|%s\n' "${base_name}" "${command_text}" >> "${manifest_rows}"
}

write_manifest() {
  local manifest_path="${output_dir}/figmix-gallery-manifest.md"
  local base_name
  local command_text

  {
    printf '# figmix gallery\n\n'
    printf 'Source: `%s`\n\n' "${source_path}"
    printf '| Variant | Exact command | Plaintext | PNG |\n'
    printf '| --- | --- | --- | --- |\n'
    while IFS='|' read -r base_name command_text; do
      printf '| `%s` | `%s` | %s | %s |\n' \
        "${base_name}" \
        "${command_text}" \
        "$(artifact_link "${base_name}" txt)" \
        "$(artifact_link "${base_name}" png)"
    done < "${manifest_rows}"
  } > "${manifest_path}"
}

has_figmix_explicit_side() {
  local argument
  for argument in "${forward_args[@]}"; do
    [[ "${argument}" == "--head" || "${argument}" == "--tail" ]] && return 0
  done
  return 1
}

has_live_timer_option() {
  local argument
  for argument in "${forward_args[@]}"; do
    case "${argument}" in
      --timer|--heading|--heading-font|--alarm|--alarm-count|--no-boom|--no-alarm)
        return 0
        ;;
    esac
  done
  return 1
}

validate_capture() {
  case "${capture_kind}" in
    figmix|toiletbox|figletbox) ;;
    *) die "--capture expects figmix, toiletbox, or figletbox" ;;
  esac

  [[ -n "${output_name}" ]] || die "--output-name is required with --capture"
  [[ "${output_name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    die "--output-name must contain only letters, numbers, dots, underscores, and hyphens"
  has_live_timer_option && die "timer options cannot be captured as static assets"

  if [[ "${capture_kind}" == "figmix" ]] && has_figmix_explicit_side; then
    return
  fi
  [[ -n "${text}" ]] || die "--text is required for this capture"
}

capture_requested_variant() {
  local -a command=("${capture_kind}" "${forward_args[@]}")

  if [[ "${capture_kind}" != "figmix" ]] || ! has_figmix_explicit_side; then
    command+=("${text}")
  fi
  capture_variant "${output_name}" "${command[@]}"
}

capture_engine_pair() {
  local head_engine="$1"
  local tail_engine="$2"
  local head_font
  local tail_font

  head_font="$(__banner_default_font "${head_engine}" head)"
  tail_font="$(__banner_default_font "${tail_engine}" tail)"
  capture_variant "figmix-engine-${head_engine}-${tail_engine}" \
    figmix --head-engine "${head_engine}" --tail-engine "${tail_engine}" \
    -H "${head_font}" -T "${tail_font}" --word "${text}"
}

capture_stable_layout_variant() {
  local base_name="$1"
  shift
  capture_variant "${base_name}" \
    figmix --head-engine toilet --tail-engine figlet -H future -T slant "$@" "${text}"
}

capture_all_layouts() {
  local split_count
  local split
  local box
  local align
  local space

  capture_stable_layout_variant figmix-layout-control --chars 1

  split_count="$(character_split_count)"
  for ((split = 1; split <= split_count; split++)); do
    capture_stable_layout_variant "figmix-layout-chars-${split}" --chars "${split}"
  done
  if has_multiple_words; then
    capture_stable_layout_variant figmix-layout-word --word
  fi

  for box in "${__banner_boxes[@]}"; do
    capture_stable_layout_variant "figmix-layout-box-$(slugify "${box}")" --chars 1 --box "${box}"
  done
  capture_stable_layout_variant figmix-layout-no-box --chars 1 --no-box

  for align in "${LAYOUT_ALIGNS[@]}"; do
    capture_stable_layout_variant "figmix-layout-align-${align}" --chars 1 --align "${align}"
  done
  for space in "${LAYOUT_SPACES[@]}"; do
    capture_stable_layout_variant "figmix-layout-space-${space}" --chars 1 --space "${space}"
  done
}

capture_all_filters() {
  local filter

  capture_variant figmix-filter-control \
    figmix --head-engine toilet --tail-engine toilet -H future -T smblock --word "${text}"
  for filter in "${__banner_toilet_filters[@]}"; do
    capture_variant "figmix-filter-head-$(slugify "${filter}")" \
      figmix --head-engine toilet --tail-engine figlet -H future -T slant \
      --head-filter "${filter}" --word "${text}"
    capture_variant "figmix-filter-tail-$(slugify "${filter}")" \
      figmix --head-engine figlet --tail-engine toilet -H slant -T smblock \
      --tail-filter "${filter}" --word "${text}"
    capture_variant "figmix-filter-shared-$(slugify "${filter}")" \
      figmix --head-engine toilet --tail-engine toilet -H future -T smblock \
      --filter "${filter}" --word "${text}"
  done
}

capture_all() {
  local font
  local box
  local filter
  local head_engine
  local tail_engine

  capture_variant figmix-auto figmix --auto "${text}"
  capture_variant figmix-word-split figmix --word -H slant -T small "${text}"
  capture_variant figmix-toilet figmix --toilet -H bigmono12 -T smblock "${text}"

  for font in "${__banner_toilet_fonts[@]}"; do
    capture_variant "toiletbox-font-$(slugify "${font}")" toiletbox -f "${font}" "${text}"
  done
  for box in "${__banner_boxes[@]}"; do
    capture_variant "toiletbox-box-$(slugify "${box}")" toiletbox -b "${box}" "${text}"
  done
  for filter in "${__banner_toilet_filters[@]}"; do
    capture_variant "toiletbox-filter-$(slugify "${filter}")" toiletbox -F "${filter}" "${text}"
  done
  for font in "${__banner_figlet_fonts[@]}"; do
    capture_variant "figletbox-font-$(slugify "${font}")" figletbox -f "${font}" "${text}"
  done
  for box in "${__banner_boxes[@]}"; do
    capture_variant "figletbox-box-$(slugify "${box}")" figletbox -b "${box}" "${text}"
  done

  for head_engine in figlet toilet; do
    for tail_engine in figlet toilet; do
      capture_engine_pair "${head_engine}" "${tail_engine}"
    done
  done
}

capture_all_mixes() {
  local head_engine
  local tail_engine
  local head_font
  local tail_font
  local -a head_fonts=()
  local -a tail_fonts=()

  for head_engine in figlet toilet; do
    if [[ "${head_engine}" == "figlet" ]]; then
      head_fonts=("${__banner_figlet_fonts[@]}")
    else
      head_fonts=("${__banner_toilet_fonts[@]}")
    fi

    for tail_engine in figlet toilet; do
      if [[ "${tail_engine}" == "figlet" ]]; then
        tail_fonts=("${__banner_figlet_fonts[@]}")
      else
        tail_fonts=("${__banner_toilet_fonts[@]}")
      fi

      for head_font in "${head_fonts[@]}"; do
        for tail_font in "${tail_fonts[@]}"; do
          if ((combine_layouts == 1)); then
            capture_font_mix_layouts "${head_engine}" "${tail_engine}" "${head_font}" "${tail_font}"
          else
            capture_variant \
              "figmix-mix-${head_engine}-${tail_engine}-$(slugify "${head_font}")-$(slugify "${tail_font}")" \
              figmix --head-engine "${head_engine}" --tail-engine "${tail_engine}" \
              -H "${head_font}" -T "${tail_font}" --word "${text}"
          fi
        done
      done
    done
  done
}

capture_font_mix_layouts() {
  local head_engine="$1"
  local tail_engine="$2"
  local head_font="$3"
  local tail_font="$4"
  local split_count
  local split

  split_count="$(character_split_count)"
  for ((split = 1; split <= split_count; split++)); do
    capture_font_mix_layout_split "${head_engine}" "${tail_engine}" "${head_font}" "${tail_font}" \
      "chars-${split}" --chars "${split}"
  done
  if has_multiple_words; then
    capture_font_mix_layout_split "${head_engine}" "${tail_engine}" "${head_font}" "${tail_font}" \
      word --word
  fi
}

capture_font_mix_layout_split() {
  local head_engine="$1"
  local tail_engine="$2"
  local head_font="$3"
  local tail_font="$4"
  local split_name="$5"
  shift 5
  local -a split_args=("$@")
  local base_name="figmix-mix-${head_engine}-${tail_engine}-$(slugify "${head_font}")-$(slugify "${tail_font}")-${split_name}"
  local box
  local align
  local space

  for box in "${__banner_boxes[@]}"; do
    for align in "${LAYOUT_ALIGNS[@]}"; do
      for space in "${LAYOUT_SPACES[@]}"; do
        capture_variant "${base_name}-box-$(slugify "${box}")-align-${align}-space-${space}" \
          figmix --head-engine "${head_engine}" --tail-engine "${tail_engine}" \
          -H "${head_font}" -T "${tail_font}" "${split_args[@]}" --box "${box}" \
          --align "${align}" --space "${space}" "${text}"
      done
    done
  done
  for align in "${LAYOUT_ALIGNS[@]}"; do
    for space in "${LAYOUT_SPACES[@]}"; do
      capture_variant "${base_name}-no-box-align-${align}-space-${space}" \
        figmix --head-engine "${head_engine}" --tail-engine "${tail_engine}" \
        -H "${head_font}" -T "${tail_font}" "${split_args[@]}" --no-box \
        --align "${align}" --space "${space}" "${text}"
    done
  done
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --text|--output-dir|--format|--capture|--output-name|--max-variants)
      [[ "$#" -ge 2 ]] || die "$1 requires a value"
      case "$1" in
        --text) text="$2" ;;
        --output-dir)
          output_dir="$2"
          output_dir_explicit=1
          ;;
        --format) format="$2" ;;
        --capture)
          [[ -z "${mode}" ]] || die "choose one mode"
          mode="capture"
          capture_kind="$2"
          ;;
        --output-name) output_name="$2" ;;
        --max-variants) max_variants="$2" ;;
      esac
      shift 2
      ;;
    --profile|--all|--all-layouts|--all-filters|--all-mixes)
      [[ -z "${mode}" ]] || die "choose one mode"
      mode="${1#--}"
      shift
      ;;
    --combine-layouts)
      combine_layouts=1
      shift
      ;;
    --)
      shift
      forward_args=("$@")
      break
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[[ -n "${mode}" ]] || \
  die "choose --profile, --all, --all-layouts, --all-filters, --all-mixes, or --capture"
[[ "${format}" == "text" || "${format}" == "png" || "${format}" == "both" ]] || \
  die "--format must be text, png, or both"
[[ -r "${source_path}" ]] || die "canonical source module was not found: ${source_path}"

if ((combine_layouts == 1)) && [[ "${mode}" != "all-mixes" ]]; then
  die "--combine-layouts is only valid with --all-mixes"
fi
if [[ -n "${max_variants}" ]] && ((combine_layouts == 0)); then
  die "--max-variants is only valid with --all-mixes --combine-layouts"
fi

case "${mode}" in
  profile)
    [[ -n "${text}" ]] || die "--text is required"
    ;;
  all)
    [[ -n "${text}" ]] || die "--text is required"
    ((output_dir_explicit == 1)) || die "--output-dir is required for --all"
    ;;
  all-layouts)
    [[ -n "${text}" ]] || die "--text is required"
    ((output_dir_explicit == 1)) || die "--output-dir is required for --all-layouts"
    ;;
  all-filters)
    [[ -n "${text}" ]] || die "--text is required"
    ((output_dir_explicit == 1)) || die "--output-dir is required for --all-filters"
    ;;
  all-mixes)
    [[ -n "${text}" ]] || die "--text is required"
    ((output_dir_explicit == 1)) || die "--output-dir is required for --all-mixes"
    if ((combine_layouts == 1)); then
      [[ -n "${max_variants}" ]] || die "--max-variants is required with --combine-layouts"
      [[ "${max_variants}" =~ ^[0-9]+$ ]] || die "--max-variants expects a non-negative integer"
      (( ${#max_variants} <= 9 )) || die "--max-variants is too large"
      planned_variants="$(combined_layout_count)"
      if ((planned_variants > 10#${max_variants})); then
        die "planned ${planned_variants} variants exceeds --max-variants ${max_variants}"
      fi
    fi
    ;;
  capture)
    validate_capture
    ;;
esac

mkdir -p "${output_dir}"
if [[ "${format}" == "png" || "${format}" == "both" ]]; then
  require_command ansilove
fi

# shellcheck source=/dev/null
source "${source_path}" || die "failed to source canonical module: ${source_path}"
require_module_contract

manifest_rows="$(mktemp "${output_dir}/.figmix-manifest.XXXXXX")"
temporary_files+=("${manifest_rows}")

case "${mode}" in
  profile)
    capture_variant profile-hero figmix --word -H slant -T small "${text}"
    printf 'Generated profile-hero.%s in %s\n' "${format}" "${output_dir}"
    ;;
  capture)
    capture_requested_variant
    write_manifest
    printf 'Generated %s.%s in %s\n' "${output_name}" "${format}" "${output_dir}"
    ;;
  all)
    capture_all
    write_manifest
    printf 'Generated curated figmix, toiletbox, and figletbox variants in %s\n' "${output_dir}"
    ;;
  all-layouts)
    capture_all_layouts
    write_manifest
    printf 'Generated figmix layout-axis variants in %s\n' "${output_dir}"
    ;;
  all-filters)
    capture_all_filters
    write_manifest
    printf 'Generated figmix filter-position variants in %s\n' "${output_dir}"
    ;;
  all-mixes)
    capture_all_mixes
    write_manifest
    if ((combine_layouts == 1)); then
      printf 'Generated %s capped figmix font-and-layout combinations in %s\n' \
        "${planned_variants}" "${output_dir}"
    else
      printf 'Generated every ordered curated figmix font mix in %s\n' "${output_dir}"
    fi
    ;;
esac
